# Daily Lingua (apps/web): environment variables of a deployment (Vercel project with the root directory apps/web).
# Copy to .env.local at the repository root for local work. Never commit real values.
# Every variable below is read by the code of apps/web or of the packages it uses; nothing else is needed at runtime.
# "Server only": never prefix it with NEXT_PUBLIC_, never expose it to the browser.

# --- Required ------------------------------------------------------------------------------------------------------

# Supabase project URL. Public: sent to the browser. Without it (or without the key below) the app fails at startup.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase public key (legacy "anon" JWT or "sb_publishable_..."). Public: Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase secret key (legacy "service_role" JWT or "sb_secret_..."). Server only, bypasses RLS. Read only by
# src/lib/supabase/service.ts, for the routes /api/events, /api/session/today, /api/reader/cards,
# /api/production/[id]/* and /api/cron/reminders; the rest of the app acts as the signed-in user.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI (optional: without a key, the model-backed features are simply unavailable) ---------------------------------

# Anthropic API key. Server only. All model calls go through one entry point that applies the global monthly cap.
ANTHROPIC_API_KEY=
# Second key, used automatically when the first is refused (credit exhausted, spend limit, revoked). Server only.
ANTHROPIC_API_KEY_FALLBACK=
# Paid written corrections and rewrite checks of the expressions: on only when set to "on".
EXPRESSION_AI=
# Shared generation of graded texts (billable model calls): on only when set to "on" and a key is set.
GRADED_TEXT_GENERATION=

# --- Reminders (Web Push) ------------------------------------------------------------------------------------------

# VAPID public key. Public: sent to the browser. Set the three VAPID values together, or none.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID private key. Server only.
VAPID_PRIVATE_KEY=
# Contact of whoever runs the server, sent to the push services ("mailto:..." or "https://..."). Default: the site origin.
VAPID_SUBJECT=
# Secret of /api/cron/reminders, at least 32 characters, server only. The GitHub workflow "Rappels de Daily Lingua"
# sends it as "Authorization: Bearer <CRON_SECRET>" (same value as the repository secret CRON_SECRET).
CRON_SECRET=

# --- Sign-up protection --------------------------------------------------------------------------------------------

# Cloudflare Turnstile site key. Public. When set, sign-in and sign-up ask for a CAPTCHA and send the token to Supabase;
# turn on Attack Protection > CAPTCHA (Turnstile, with the secret key) in the Supabase dashboard too.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Pre-release ---------------------------------------------------------------------------------------------------

# "1" shows the "Préversion" mention at the bottom of the Settings page. Public. Leave it empty on a normal deployment.
NEXT_PUBLIC_PREVIEW_LABEL=

# --- Content drafts (local work and previews only) -----------------------------------------------------------------

# "show" also grades and offers units that are not published yet. Ignored when VERCEL_ENV is "production".
UNIT_DRAFTS=

# --- Set by Vercel (do not define) ---------------------------------------------------------------------------------

# VERCEL_ENV: "production", "preview" or "development".
# VERCEL_GIT_COMMIT_SHA: the commit of the deployment; its first 7 characters are the version shown in Settings and sent
# with the feedback ("local" when absent).
