# Daily Lingua: environment variables.
# Copy this file to .env.local and fill in values. Never commit real keys.
#
# Without any Supabase variable the app runs entirely on demo data (this is the
# case on Vercel today). Set all of them, or none: a partial set is rejected at startup.

# Phase 2-3: Supabase. Local values are printed by `npm run db:status` (see the README).
# Supabase project URL. Safe to expose to the browser.
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Public key (legacy "anon" JWT or "sb_publishable_..."). Safe to expose to the browser:
# Row Level Security is what protects the data.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key (legacy "service_role" JWT or "sb_secret_..."). SERVER ONLY, bypasses RLS:
# never prefix it with NEXT_PUBLIC_, never expose it to the browser, never commit it.
# Used by `npm run content:ingest` and by the app server to write the daily mission
# (phase 5): server only.
# SUPABASE_SERVICE_ROLE_KEY=

# Phase 4: which content sources may be used. "all" (default): every source of the catalogue,
# for personal use. "commercial": only sources whose terms allow a paid product (open licences).
# Set it to "commercial" before selling the app.
# CONTENT_LICENSE_POLICY=all

# Phase H1: grammar points no native speaker has approved yet (reviewedOn: null). "show" (default
# outside production) lists them with a "Non relue" badge; "hide" (default when VERCEL_ENV is
# "production") keeps them out of the app.
# GRAMMAR_DRAFTS=show

# Phase I1: alphabets (Cyrillic) no native speaker has approved yet (reviewedOn: null). Same
# values and defaults as GRAMMAR_DRAFTS.
# ALPHABET_DRAFTS=show

# Phase 5: mission generation (server-side only).
# Anthropic API key. SERVER ONLY: never prefix it with NEXT_PUBLIC_, never commit it.
# ANTHROPIC_API_KEY=
# Optional second key, used automatically when the first is refused (credit exhausted, spend limit,
# revoked, rate limit). Server only.
# ANTHROPIC_API_KEY_FALLBACK=
# claude | template. Default: claude when a key is set, otherwise template (no model call,
# production task only).
# MISSION_GENERATOR=
# Model that writes the exercises (default: claude-haiku-5-5).
# MISSION_MODEL=claude-haiku-5-5
# Correction of the written production (same ANTHROPIC_API_KEY): on as soon as the key is set.
# on | off. Without a key it is off and the mission screen shows no correction button.
# WRITING_FEEDBACK=on
# Model of the correction (default: claude-haiku-5-5). Calibrate with `npm run feedback:eval`.
# WRITING_FEEDBACK_MODEL=claude-haiku-5-5
# Automatic translation of imported words (same ANTHROPIC_API_KEY): on as soon as the key is set,
# for full accounts only (50 words per request, 200 per day). on | off.
# VOCABULARY_TRANSLATION=on
# Model of the translation (default: claude-haiku-5-5).
# VOCABULARY_TRANSLATION_MODEL=claude-haiku-5-5
# Classification of the contents by domain at ingestion (same ANTHROPIC_API_KEY): on as soon as the
# key is set; sources with fixed domains in the catalogue are not sent. on | off.
# CONTENT_TOPICS=on
# Model of the classification (default: claude-haiku-5-5).
# CONTENT_TOPICS_MODEL=claude-haiku-5-5

# Phase 6: secret of the scheduled jobs (/api/cron/*). SERVER ONLY, at least 32 characters.
# The GitHub Actions workflow (.github/workflows/scheduled-jobs.yml) sends it as
# "Authorization: Bearer <CRON_SECRET>". Without it the job routes answer 503.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRON_SECRET=

# Optional, SERVER ONLY: contact address shown on the privacy page (/confidentialite).
# Without it, the page only points to "Envoyer un retour" in the app.
# CONTACT_EMAIL=

# Phase A: guest trial (accounts without e-mail).
# Optional: Cloudflare Turnstile site key (public). When set, « Essayer sans compte », sign-in,
# sign-up and « Mot de passe oublié » ask for a CAPTCHA and send the token to Supabase. Turn on Attack Protection > CAPTCHA (Turnstile, with the
# secret key) in the Supabase dashboard too, see docs/plans/product-features.md.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# SERVER ONLY: how many missions all guests together may start per rolling 24 hours (default 300,
# "off" for no cap). A ceiling on the model money anonymous accounts can spend.
# GUEST_DAILY_MISSION_CAP=300
