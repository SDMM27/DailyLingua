# Daily Lingua: environment variables.
# Copy this file to .env.local and fill in values. Never commit real keys.
#
# Phase 1 runs entirely on demo data: no variable is required yet.

# Phase 2: Supabase (public URL + anon key are safe in the browser; the service role key is NOT).
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Phase 5: language model provider (server-side only).
# LLM_API_KEY=

# Phase 6: secret checked by the daily generation cron endpoint.
# CRON_SECRET=
